{
  "name": "@nusaquant/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node --import tsx src/ingest.ts",
    "dev": "RUN_MARKET_INGEST=true RUN_MARKET_WATCH=true node --import tsx src/ingest.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "node --import tsx src/ingest.ts",
    "ingest:watch": "node --import tsx src/ingest.ts",
    "ingest:backfill": "RUN_MARKET_BACKFILL=true node --import tsx src/backfill.ts",
    "research:backfill": "RUN_RESEARCH_ARCHIVE_BACKFILL=true node --import tsx src/research-backfill.ts",
    "research:funding": "RUN_RESEARCH_FUNDING_BACKFILL=true node --import tsx src/funding-backfill.ts",
    "research:metrics": "RUN_RESEARCH_METRICS_BACKFILL=true node --import tsx src/metrics-backfill.ts",
    "research:local": "node --import tsx src/local-research.ts",
    "desk:dry": "node --import tsx src/desk-dry.ts",
    "desk:diag": "node --import tsx src/desk-diag.ts",
    "audit:teknik": "node --import tsx src/audit-teknik.ts"
  },
  "dependencies": {
    "@nusaquant/core": "0.1.0",
    "@supabase/supabase-js": "^2.109.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "tsx": "4.23.13",
    "typescript": "5.7.2"
  }
}
