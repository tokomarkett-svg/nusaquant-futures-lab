# Application
NODE_ENV=development
APP_NAME=NusaQuant Futures Lab

# Database SQLite lokal (pengganti Supabase — tidak ada kredensial cloud).
# Path file database; folder induk dibuat otomatis bila belum ada.
# Default bila kosong: ./data/nusaquant.db (relatif terhadap folder kerja proses).
SQLITE_PATH=./data/nusaquant.db
# Backup = salin file-file ini saat worker & web berhenti:
#   nusaquant.db, nusaquant.db-wal, nusaquant.db-shm

# Auth operator lokal (pengganti Supabase Auth).
# OPERATOR_PASSWORD_HASH: hash scrypt kata sandi operator, format:
#   $scrypt$N=16384,r=8,p=1$<saltHex>$<hashHex>
# Buat dengan: npm run hash-password --workspace @nusaquant/db
# JANGAN menaruh kata sandi mentah di sini.
OPERATOR_PASSWORD_HASH=
# OPERATOR_SESSION_SECRET: string acak min. 16 karakter untuk menandatangani cookie sesi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_SESSION_SECRET=

# Eksekusi DEMO (Binance Futures TESTNET — uang pura-pura resmi, bukan uang asli):
# 1) buat kunci di https://testnet.binancefuture.com → API Key (HMAC)
BINANCE_TESTNET_API_KEY=<redacted>
BINANCE_TESTNET_API_SECRET=<redacted>
# Worker AND Vercel: default fail-closed; do not set to 1 until readiness, auth and DB checks pass.
DEMO_EXECUTION_ENABLED=0
# 2) token bersama web→worker (isi nilai yang SAMA di Vercel: WORKER_EXEC_TOKEN)
EXEC_TOKEN=<redacted>
WORKER_EXEC_TOKEN=<redacted>
# Mainnet remains hard-locked in code; no live Binance credentials are used.

# Jembatan data futures: alamat publik worker (mis. https://xxx.up.railway.app).
# Diisi di VERCEL supaya papan membaca pasar futures — SAMA dengan notif Telegram & meja paper.
WORKER_DATA_URL=

# Binance - do not use real credentials in development
BINANCE_API_KEY=<redacted>
BINANCE_API_SECRET=<redacted>
BINANCE_BASE_URL=https://testnet.binancefuture.com

# One-time historical backfill; run worker ingest:backfill manually
BACKFILL_DAYS=365
BACKFILL_INTERVALS=15m,1h
# Optional one-time research archive backfill; public bulk data only.
RESEARCH_ARCHIVE_START=
RESEARCH_ARCHIVE_END=
RESEARCH_ARCHIVE_SYMBOLS=BTCUSDT,ETHUSDT
RESEARCH_ARCHIVE_INTERVALS=15m,1h
RESEARCH_FUNDING_START=
RESEARCH_FUNDING_END=
RESEARCH_FUNDING_SYMBOLS=BTCUSDT,ETHUSDT

# Arsip candle lokal (worker menulis ke SQLite; web membaca dari file yang sama bila satu mesin).
RUN_MARKET_INGEST=false
INGEST_INTERVAL_MS=300000

# Mesin paper lama berbasis bot_sessions (opsional; BUKAN Meja PMB).
# Biarkan false untuk mode hemat. Jika true, hanya BTC/ETH + ID eksplisit yang dipoll.
RUN_SESSION_CONTROL=false
BOT_SESSION_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002
CONTROL_POLL_INTERVAL_MS=30000
# Enable only after the research tables exist (dibuat otomatis oleh SQLite).
RUN_RESEARCH_JOBS=false
RESEARCH_JOB_POLL_MS=15000

# Telegram: alarm tiket teknis Futures HANYA setelah web mengonfirmasi rumus & setup yang sama.
# Status Binance Demo/Testnet dilaporkan terpisah; koin yang tidak ada di Testnet tetap terpantau.
# Railway EXEC_TOKEN harus SAMA dengan WORKER_EXEC_TOKEN di Vercel; bila hilang, alarm SIAP diblokir.
# Opsional Railway: origin Vercel tempat preflight aplikasi (default web-gray-eta-79.vercel.app).
ALERT_CHECK_BASE_URL=https://web-gray-eta-79.vercel.app
# Pemindaian terus berlangsung; tidak ada auto-order Binance.
RUN_ALERTS=false
# Tombol keselamatan terpisah: RUN_ALERTS=true saja TIDAK mengirim Telegram.
# Setelah uji tiket & konfigurasi token/chat, set PMB_NOTIF=1 untuk mengizinkan pengiriman.
# Biarkan 0 selama audit / dry run; log akan menyatakan pesan dibungkam.
PMB_NOTIF=0
ALERT_POLL_MS=120000
TELEGRAM_BOT_TOKEN=<redacted>
TELEGRAM_CHAT_ID=

# Alamat web papan (tanpa garis miring di ujung) → notif Telegram dapat tautan chart langsung
PAPAN_URL=

# Mesin = PERSIS teknik manual asli: LONG & SHORT, stop ekor candle 1, gate searah 1 jam.
# Tidak ada variabel tambahan yang perlu diisi. (Opsi eksperimen hanya ada di alat uji balik, bukan produksi.)
#
# Sumber data pemindaian teknik (notif, meja, papan json): FUTURES dulu (fapi) — sama dengan
# chart yang dilihat murid. Bila fapi tak terjangkau (HTTP 451), otomatis jatuh ke mirror spot
# DAN notif menandai "Data SPOT" supaya tidak menyesatkan. Kosongkan = fapi.
SCAN_BINANCE_BASE_URL=

# Meja Papan: eksekutor PAPER otomatis (buka posisi saat tiket siap, awasi SL/TP, tulis jurnal)
RUN_DESK=false
DESK_POLL_MS=120000
# Mode notifikasi READY-only dipaksakan di worker; setelan ALERT_MODE lama diabaikan.
ALERT_MODE=tiketsiap
