# Application
NODE_ENV=development
APP_NAME=NusaQuant Futures Lab

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server/worker only. Never expose this as NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Database - optional direct server connection
DATABASE_URL=

# Binance - do not use real credentials in development
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binancefuture.com

# One-time historical backfill; run worker ingest:backfill manually
BACKFILL_DAYS=365
BACKFILL_INTERVALS=15m,1h
# Optional one-time research archive backfill; public bulk data, worker/service-role only.
RESEARCH_ARCHIVE_START=
RESEARCH_ARCHIVE_END=
RESEARCH_ARCHIVE_SYMBOLS=BTCUSDT,ETHUSDT
RESEARCH_ARCHIVE_INTERVALS=15m,1h
RESEARCH_FUNDING_START=
RESEARCH_FUNDING_END=
RESEARCH_FUNDING_SYMBOLS=BTCUSDT,ETHUSDT

# Paper session control - worker only
BOT_SESSION_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002
CONTROL_POLL_INTERVAL_MS=10000
# Enable only after the research_backtest_jobs migration is applied.
RUN_RESEARCH_JOBS=false
RESEARCH_JOB_POLL_MS=15000

# Optional notifications - to be configured later
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
